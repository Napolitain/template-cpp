# Keep profiling flags local to our targets, including the full-LTO backend.
set(template_PGO "OFF" CACHE STRING "PGO: OFF, GENERATE, USE, SAMPLE_GENERATE or SAMPLE_USE")
set_property(CACHE template_PGO PROPERTY STRINGS OFF GENERATE USE SAMPLE_GENERATE SAMPLE_USE)
set(template_PGO_PROFILE "" CACHE FILEPATH "LLVM instrumentation or sample profile")
set(template_PROPELLER "OFF" CACHE STRING "Propeller: OFF, GENERATE or USE")
set_property(CACHE template_PROPELLER PROPERTY STRINGS OFF GENERATE USE)
set(template_PROPELLER_CC_PROFILE "" CACHE FILEPATH "Propeller basic-block layout profile")
set(template_PROPELLER_LD_PROFILE "" CACHE FILEPATH "Propeller symbol order profile")

if(NOT template_PGO MATCHES "^(OFF|GENERATE|USE|SAMPLE_GENERATE|SAMPLE_USE)$")
    message(FATAL_ERROR "Invalid template_PGO mode: ${template_PGO}")
endif()
if(NOT template_PROPELLER MATCHES "^(OFF|GENERATE|USE)$")
    message(FATAL_ERROR "Invalid template_PROPELLER mode: ${template_PROPELLER}")
endif()
if(template_PGO STREQUAL "OFF" AND template_PROPELLER STREQUAL "OFF")
    return()
endif()
if(NOT CMAKE_CXX_COMPILER_ID MATCHES "^(Clang|AppleClang)$")
    message(FATAL_ERROR "Profiling requires Clang and matching LLVM tools")
endif()
if(CMAKE_CONFIGURATION_TYPES OR NOT CMAKE_BUILD_TYPE STREQUAL "Release")
    message(FATAL_ERROR "Profiling requires a single-configuration Release build")
endif()
if(template_COVERAGE OR template_MUTATION)
    message(FATAL_ERROR "Profiling cannot be combined with coverage or mutation instrumentation")
endif()
if(NOT template_PROPELLER STREQUAL "OFF" AND template_PGO MATCHES "^(GENERATE|SAMPLE_GENERATE)$")
    message(FATAL_ERROR "Train PGO first; combine Propeller with OFF, USE or SAMPLE_USE")
endif()
# Use identical internal function names when PGO is later combined with layout.
target_compile_options(template_options INTERFACE -funique-internal-linkage-names)

# Track profile contents, not just filenames, so replacing a profile rebuilds
# objects and reruns LTO. configure_file also registers a configure dependency.
function(template_copy_profile input label output)
    if(NOT IS_ABSOLUTE "${input}" OR NOT EXISTS "${input}" OR IS_DIRECTORY "${input}")
        message(FATAL_ERROR "${label} must name an existing absolute profile file")
    endif()
    file(SIZE "${input}" size)
    if(size EQUAL 0)
        message(FATAL_ERROR "${label} is empty; collect a longer representative workload")
    endif()
    file(SHA256 "${input}" hash)
    set(copy "${CMAKE_BINARY_DIR}/${label}-${hash}.profile")
    configure_file("${input}" "${copy}" COPYONLY)
    set(${output} "${copy}" PARENT_SCOPE)
endfunction()

if(template_PGO MATCHES "^SAMPLE_" OR NOT template_PROPELLER STREQUAL "OFF")
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_CXX_COMPILER_VERSION VERSION_LESS 21)
        message(FATAL_ERROR "AutoFDO/Propeller presets require Linux and Clang/LLD 21 or newer")
    endif()
    find_program(TEMPLATE_LLD ld.lld REQUIRED)
    target_link_options(template_options INTERFACE -fuse-ld=lld "LINKER:--build-id")
endif()

if(template_PGO STREQUAL "GENERATE")
    set(_pgo_flag "-fprofile-generate=${CMAKE_BINARY_DIR}/profiles")
elseif(template_PGO STREQUAL "USE")
    template_copy_profile("${template_PGO_PROFILE}" pgo _pgo_copy)
    set(_pgo_flag "-fprofile-use=${_pgo_copy}")
elseif(template_PGO STREQUAL "SAMPLE_USE")
    template_copy_profile("${template_PGO_PROFILE}" autofdo _pgo_copy)
    set(_pgo_flag "-fprofile-sample-use=${_pgo_copy}")
    target_link_options(template_options INTERFACE "LINKER:--lto-sample-profile=${_pgo_copy}")
endif()
if(DEFINED _pgo_flag)
    target_compile_options(template_options INTERFACE "${_pgo_flag}")
    target_link_options(template_options INTERFACE "${_pgo_flag}")
endif()
if(template_PGO MATCHES "^SAMPLE_")
    target_compile_options(template_options INTERFACE -gline-tables-only -fdebug-info-for-profiling)
endif()

if(template_PROPELLER STREQUAL "GENERATE")
    target_compile_options(template_options INTERFACE -fbasic-block-address-map)
    target_link_options(template_options INTERFACE "LINKER:--lto-basic-block-address-map")
elseif(template_PROPELLER STREQUAL "USE")
    template_copy_profile("${template_PROPELLER_CC_PROFILE}" propeller-cc _propeller_cc)
    template_copy_profile("${template_PROPELLER_LD_PROFILE}" propeller-ld _propeller_ld)
    target_compile_options(template_options INTERFACE
        "-fbasic-block-sections=list=${_propeller_cc}" -funique-basic-block-section-names)
    target_link_options(template_options INTERFACE
        "LINKER:--lto-basic-block-sections=${_propeller_cc}"
        "LINKER:--lto-unique-basic-block-section-names"
        "LINKER:--symbol-ordering-file=${_propeller_ld}")
endif()

# perf converters need the original symbols (and AutoFDO needs line tables).
if(template_PGO STREQUAL "SAMPLE_GENERATE" OR template_PROPELLER STREQUAL "GENERATE")
    set(_template_profile_collection ON)
endif()
